# Public runtime configuration for frontend-v8.
# Copy to `.env` for local dev, or set these in Vercel → Project Settings →
# Environment Variables for production. All are OPTIONAL — sensible production
# fallbacks live in src/lib/config.ts, so the app builds/runs without a .env.
#
# NOTE: only variables prefixed PUBLIC_ are exposed to client code in SvelteKit.

# Base URL of the read-only Cloudflare Worker public API (UNCHANGED backend).
PUBLIC_API_BASE="https://chhath-public-worker.shaharpura.com"

# Management portal login (opened from the footer / header link).
PUBLIC_MGMT_LOGIN_URL="https://mgmt-chhath.shaharpura.com/"

# Canonical site URL (SEO / manifest / sitemap).
PUBLIC_SITE_URL="https://chhath.shaharpura.com"

# --- Build-time accounts snapshot (see README: "The accounts in words") ---------------------------
# Both are EMERGENCY switches for a build when the API is down and a deploy cannot wait. Leave them
# unset normally: by default a build that cannot read the API FAILS, and Vercel keeps serving the
# previous deployment (with the last good text in it).
#
# Build without a snapshot if the API cannot be reached:
# CPM_SNAPSHOT_ALLOW_EMPTY=1
#
# Skip the snapshot (and the network call) altogether:
# CPM_SNAPSHOT=off
